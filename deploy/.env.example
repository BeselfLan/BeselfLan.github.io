# Every host-specific value for the backend lives here. Copy this file to
# deploy/.env (git-ignored) and fill it in. Example hosts use example.com only.

# The site Caddy serves. A host name such as api.example.com gets automatic
# HTTPS; ":80" serves plain HTTP for a local run. Required.
API_SITE=

# Host ports for Caddy. On a laptop pick a free HTTP_PORT: the local override
# publishes only that one, on 127.0.0.1.
HTTP_PORT=80
HTTPS_PORT=443

# Where browsers fetch media files, without a trailing slash. Required.
# Examples: https://api.example.com/media/files
#           http://127.0.0.1:<HTTP_PORT>/media/files
PUBLIC_MEDIA_BASE_URL=

# Exact origins allowed to call the API, comma-separated, no trailing slash. In
# topology (b) also list the site's origin, such as https://example.com.
CORS_ORIGINS=https://beselflan.github.io,http://localhost:3000

# The API image. Empty means beselfos-api:local. In production use a tag such
# as ghcr.io/beselflan/beselfos-api:<git sha>.
API_IMAGE=

# The host folder served as /media. Empty means media/ next to the compose
# file: /srv/beselfos/media on the VPS, where scripts/media/sync.sh sends files.
# The local override (docker-compose.local.yml) defaults to apps/api/media.
MEDIA_HOST_DIR=

# Which compose files run. Compose reads this itself from the .env in the
# folder it runs in (/srv/beselfos on the VPS). Keep it commented out unless
# it has a value: an empty COMPOSE_FILE= stops Compose. Unset runs our own
# Caddy on 80 and 443. For a host that already runs a Caddy, use:
# COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# Topology (b), the site on this host too, uses:
# COMPOSE_FILE=docker-compose.yml:docker-compose.web.yml
# and appends :docker-compose.edge.yml for a host that already runs a Caddy.

# Only with docker-compose.edge.yml: the Docker network of the host's Caddy.
EDGE_NETWORK=

# Topology (b) only: the site's host, served by our Caddy beside API_SITE. One
# host such as example.com, or a list such as example.com, www.example.com.
# A local run uses http://web.localhost.
WEB_SITE=

# Topology (b) only: the site image. Empty means beselfos-web:local. Use one
# tag per commit, such as beselfos-web:<git sha>, so a rollback is the
# previous tag.
WEB_IMAGE=

# Topology (b) only, read when the site image is built and never at run time:
# the API's origin, such as https://api.example.com, with no path and no
# trailing slash. It is baked into the image and its Content-Security-Policy,
# so an image is built for one API host.
NEXT_PUBLIC_API_URL=

# Optional. Empty means off.
# Without RESEND_API_KEY and CONTACT_TO, POST /api/contact answers 503.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
# Reserved: nothing reads it yet.
ADMIN_TOKEN=
# Without these two, the stats routes answer 503.
DMOJ_USER=
GITHUB_USER=

# Read from the shell by scripts/media/sync.sh, not by Compose. An rsync
# destination, for example deploy@vps.example.com:/srv/beselfos/media
MEDIA_SYNC_TARGET=
